+                'max_length': _('O status não pode ter mais de 255 caracteres.'),
+            }
+        }
+
+    def clean_status(self):
+        status = self.cleaned_data.get('status')
+        if status:
+            status = status.strip()
+            if len(status) < 2:
+                raise ValidationError(_('O status deve ter pelo menos 2 caracteres.'))
+            if not status.replace(' ', '').isalnum():
+                raise ValidationError(_('O status deve conter apenas letras, números e espaços.'))
+        return status
+
+    def clean_description(self):
+        description = self.cleaned_data.get('description', '')
+        if description:
+            description = description.strip()
+        return description
+
+    def save(self, commit=True):
+        instance = super().save(commit=False)
+        instance.status = instance.status.strip() if instance.status else instance.status
+        if commit:
+            instance.save()
+        return instance
